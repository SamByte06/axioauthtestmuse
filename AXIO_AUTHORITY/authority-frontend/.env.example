# AxioVital Authority frontend — environment configuration.
# Copy to .env.local and adjust. Restart the dev server after changes.

# Base URL of the AxioVital Authority backend (REST over HTTPS).
# When set, the console talks to the real backend.
# NEXT_PUBLIC_AUTHORITY_API_BASE_URL=https://authority.axiovital.example

# Session cookie name configured on the backend and read by the frontend middleware.
# AUTHORITY_SESSION_COOKIE_NAME=axio_authority_session

# Demo mode (OFF by default). When set to "true", the console is served by an
# in-memory fixture backend instead of a real backend, and every page shows a
# persistent amber DEMO banner. Any valid-form credentials sign in as the demo
# administrator. All records are clearly-labeled TEST fixtures (e.g.
# Medanta (TEST), AXP-KL-7K42F8) and state resets on reload.
# Demo mode is hard-blocked from executing in production builds.
# NEVER enable demo mode in production or against real data.
# NEXT_PUBLIC_AUTHORITY_DEMO_MODE=true
