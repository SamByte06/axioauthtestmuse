# =============================================================================
# AXIOVITAL AUTHORITY — environment configuration
# Copy to .env.local (frontend) and fill in real values. Never commit secrets.
# =============================================================================

# Base URL of the AxioVital backend Authority API (REST over HTTPS).
# The Authority frontend ONLY talks to this backend. It never connects
# directly to PostgreSQL, Redis, or any infrastructure service.
NEXT_PUBLIC_AUTHORITY_API_BASE_URL=https://authority-api.axiovital.example

# Backend-issued authority environment label shown in the shell footer
# (e.g. "production", "staging", "development").
NEXT_PUBLIC_AUTHORITY_ENVIRONMENT=development

# Session cookie name configured on the backend and read by the frontend middleware.
AUTHORITY_SESSION_COOKIE_NAME=axio_authority_session

# Demo mode (OFF by default). Must NEVER be enabled in production environments.
# Blocked automatically in production builds (NODE_ENV=production or NEXT_PUBLIC_VERCEL_ENV=production).
# When active, a persistent amber DEMO banner is displayed on all pages.
# NEXT_PUBLIC_AUTHORITY_DEMO_MODE=true

# Optional: override for local backend development
# NEXT_PUBLIC_AUTHORITY_API_BASE_URL=http://localhost:8080
